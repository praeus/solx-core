package sol:actions@0.1.0;

/// Shared types used by sol custom action interfaces.
interface types {
  /// Result returned after executing an action.
  record action-result {
    success: bool,
    message: option<string>,
    output: option<string>,
  }
}

/// Host interface for executing another sol action from within a custom WASM component.
///
/// Calls are attributed to the calling action: the host tags each one with the
/// guest's own reference, which the built-ins use to scope what it can reach.
/// Concretely, `get-secret`/`set-secret` resolve only against keys in the
/// *calling* action's own `action_config.secrets`, and `entity_save_action` /
/// `entity_delete_action` refuse to create, modify, or remove `command` and
/// `webhook` actions — a guest cannot grant itself shell or outbound HTTP.
/// Everything else in the built-in catalogue is reachable without restriction;
/// there is no general permission system yet.
interface action-exec {
  use types.{action-result};
  /// Execute a named sol action with a JSON-encoded payload.
  exec: func(action-name: string, payload: string) -> result<action-result, string>;
}

/// Host interface for reading artifact bytes from within a custom WASM component.
///
/// NOTE: unrestricted — any path in the file store is readable. There is no
/// per-artifact permission check today.
interface artifact-read {
  /// Read the raw bytes of an artifact by name.
  read: func(name: string) -> result<list<u8>, string>;
}

/// Host-provided logging (maps to the host tracing/logging subsystem).
interface logger {
  log: func(message: string);
}

/// The interface every sol custom action component must export.
interface runner {
  use types.{action-result};
  run: func(action-name: option<string>, params: string) -> result<action-result, string>;
}

/// World for user-supplied custom WASM action components.
///
/// Custom components only get action dispatch and artifact reads. Direct DB,
/// filesystem, model, and system-ops access is not available — all sensitive
/// operations must go through named sol actions, where the two restrictions
/// described on `action-exec` apply.
///
/// Build target: wasm32-wasip2
world custom-action {
  import action-exec;
  import artifact-read;
  import logger;
  export runner;
}
